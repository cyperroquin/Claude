# Copier ce fichier en .env et le remplir. Ne jamais versionner .env.

# Destinataire(s) de la veille, séparés par des virgules (adresse à confirmer
# avec le responsable de la veille).
EMAIL_DESTINATAIRE=
# Adresse d'expédition (par défaut : SMTP_USER).
EMAIL_EXPEDITEUR=

# Option 1 : SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Mettre 0 pour désactiver STARTTLS (le port 465 utilise SSL directement).
SMTP_STARTTLS=1

# Option 2 : Resend (prioritaire sur SMTP si renseigné)
RESEND_API_KEY=

# Phase 2 (non utilisé pour l'instant)
NOTION_TOKEN=
