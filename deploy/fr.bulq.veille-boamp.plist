<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Veille BOAMP sous macOS : tous les jours à 7 h 30 (heure locale du Mac,
  donc heure de Paris si le Mac est réglé sur ce fuseau).
  1. Remplacer /chemin/vers/veille-boamp.
  2. cp deploy/fr.bulq.veille-boamp.plist ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/fr.bulq.veille-boamp.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.bulq.veille-boamp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/chemin/vers/veille-boamp/deploy/lancer.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
</dict>
</plist>
